<div class="max-w-4xl mx-auto">
  <header class="mb-8">
    <h1 class="text-4xl font-bold mb-4"><%= @blog.title %></h1>
    <div class="flex items-center justify-between text-gray-600 mb-4">
      <div>
        <p>By <span class="font-semibold"><%= @blog.user_fullname %></span></p>
        <time><%= Calendar.strftime(@blog.inserted_at, "%B %d, %Y") %></time>
        <span :if={@blog.updated_at != @blog.inserted_at}>
          (Updated <%= Calendar.strftime(@blog.updated_at, "%B %d, %Y") %>)
        </span>
      </div>
      
      <div :if={@current_user && @current_user.id == @blog.user_id} class="flex gap-2">
        <.link navigate={~p"/blogs/#{@blog.slug}/edit"}>
          <.button>Edit</.button>
        </.link>
        <.link href={~p"/blogs/#{@blog.slug}"} method="delete" 
               data-confirm="Are you sure you want to delete this blog post?">
          <.button class="bg-red-600 hover:bg-red-700">Delete</.button>
        </.link>
      </div>
    </div>
  </header>

  <div :if={@blog.image} class="mb-8">
    <img src={@blog.image} alt={@blog.title} class="w-full max-h-96 object-cover rounded-lg" />
  </div>

  <article class="prose prose-lg max-w-none">
    <div class="whitespace-pre-line"><%= @blog.description %></div>
  </article>

  <div class="mt-8 pt-8 border-t border-gray-200">
    <.link navigate={~p"/blogs"} class="text-blue-600 hover:underline">
      ← Back to all posts
    </.link>
  </div>
</div>