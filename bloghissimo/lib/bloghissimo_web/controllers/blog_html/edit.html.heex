<.header>
  Edit Blog Post
</.header>

<.simple_form :let={f} for={@changeset} as={:blog} action={~p"/blogs/#{@blog.slug}"} method="put" class="space-y-8">
  <.error :if={@changeset.action}>
    Oops, something went wrong! Please check the errors below.
  </.error>

  <.input field={f[:title]} type="text" label="Title" required />
  <.input field={f[:image]} type="url" label="Image URL" />
  <.input field={f[:description_short]} type="textarea" label="Short Description" rows="3" required />
  <.input field={f[:description]} type="textarea" label="Full Description" rows="10" required />

  <:actions>
    <.button phx-disable-with="Updating..." class="w-full">
      Update Blog Post
    </.button>
  </:actions>
</.simple_form>

<div class="mt-4 flex justify-between">
  <.link navigate={~p"/blogs/#{@blog.slug}"} class="text-blue-600 hover:underline">
    ← Back to post
  </.link>
  <.link navigate={~p"/blogs"} class="text-blue-600 hover:underline">
    All posts
  </.link>
</div>