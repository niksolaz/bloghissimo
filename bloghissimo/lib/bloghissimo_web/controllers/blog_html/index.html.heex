<.header>
  All Blog Posts
  <:actions>
    <.link :if={@current_user} navigate={~p"/blogs/new"}>
      <.button>New Blog Post</.button>
    </.link>
  </:actions>
</.header>

<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 py-5">
  <div :for={blog <- @blogs} class="bg-white rounded-lg shadow-md overflow-hidden relative">
    <div :if={blog.image} class="h-48 bg-gray-200">
      <img src={blog.image} alt={blog.title} class="w-full h-full object-cover" />
    </div>
    <div class="p-6">
      <h3 class="text-xl font-semibold mb-2">
        <.link navigate={~p"/blogs/#{blog.slug}"} class="text-blue-600 hover:underline">
          <%= blog.title %>
        </.link>
      </h3>
      <p class="text-gray-600 text-sm mb-2 truncate" title={blog.user_fullname}>By <%= blog.user_fullname %></p>
      <p class="text-gray-700 mb-4 py-4 text-ellipsis overflow-hidden"><%= blog.description_short %></p>
    </div>
    <div class="flex justify-between items-center text-sm text-gray-500 absolute bottom-2 left-2 right-2">
      <time><%= Calendar.strftime(blog.inserted_at, "%B %d, %Y") %></time>
      <.link navigate={~p"/blogs/#{blog.slug}"} class="text-blue-600 hover:underline">
        Read more →
      </.link>
    </div>
  </div>
</div>

<div :if={@blogs == []} class="text-center py-12">
  <p class="text-gray-500 text-lg">No blog posts yet.</p>
  <.link :if={@current_user} navigate={~p"/blogs/new"} class="text-blue-600 hover:underline">
    Create the first one!
  </.link>
</div>