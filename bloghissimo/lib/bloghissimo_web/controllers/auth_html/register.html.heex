<div class="mx-auto max-w-sm">
  <.header class="text-center">
    Register for an account
    <:subtitle>
      Already registered?
      <.link navigate={~p"/login"} class="font-semibold text-brand hover:underline">
        Log in
      </.link>
      to your account now.
    </:subtitle>
  </.header>

  <.simple_form :let={f} for={@changeset} as={:user} action={~p"/register"} class="space-y-8">
    <.error :if={@changeset.action}>
      Oops, something went wrong! Please check the errors below.
    </.error>

    <.input field={f[:name]} type="text" label="First Name" required />
    <.input field={f[:surname]} type="text" label="Last Name" required />
    <.input field={f[:email]} type="email" label="Email" required />
    <.input field={f[:password]} type="password" label="Password" required />
    <.input field={f[:phone]} type="text" label="Phone" />
    <.input field={f[:address]} type="text" label="Address" />
    <.input field={f[:city]} type="text" label="City" />
    <.input field={f[:country]} type="text" label="Country" />
    <.input field={f[:cap]} type="text" label="ZIP Code" />

    <:actions>
      <.button phx-disable-with="Creating account..." class="w-full">
        Create an account
      </.button>
    </:actions>
  </.simple_form>
</div>